{
  "name": "scaledock-skills",
  "version": "0.0.0",
  "private": true,
  "description": "Agent skills used across ScaleDock projects",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "check": "pnpm format:check && pnpm validate",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "inventory": "node scripts/inventory-standards.mjs",
    "prepare": "node scripts/prepare.ts",
    "sources:check": "node scripts/check-sources.mjs",
    "validate": "node scripts/validate-skills.mjs",
    "verify": "pnpm check",
    "versions:check": "node scripts/check-version-lines.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@commitlint/types": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "24.x",
    "pnpm": "12.8.1"
  },
  "packageManager": "pnpm@12.8.1"
}
